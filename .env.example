# ====================================================================
# Digital Agency Website: Environment Configuration Example
# Copy this file to .env.local and fill in your project credentials
# DO NOT COMMIT SECRETS OR SERVICE ROLE KEYS TO VERSION CONTROL
# ====================================================================

# 1. Supabase Project Configuration
# Found in: Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Privileged Supabase Service Role Key (Server-Only, Bypasses RLS for secure Server Actions)
# NEVER expose this key in NEXT_PUBLIC_ variables or client bundles!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# 2. Transactional Email Provider (Resend or equivalent SMTP)
# Used to dispatch internal alerts when new project briefs are submitted
# If unset, leads are still saved safely and jobs are marked for retry in /admin
RESEND_API_KEY="re_123456789_abcdefg"
AGENCY_NOTIFICATION_EMAIL="hello@cobaltkinetic.example.com"

# 3. Optional Public Site Configuration
NEXT_PUBLIC_SITE_URL="https://cobaltkinetic.example.com"
